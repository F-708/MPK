<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="МПК • Расписание"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Сегодня"
            android:textColor="#0D3B66"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle with group and date -->
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="Группа 41О • Понедельник"
        android:textColor="#486284"
        android:textSize="11sp" />

    <!-- Lesson 1 -->
    <LinearLayout
        android:id="@+id/lesson_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/l1_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="1 · 08:30"
            android:textColor="#0D3B66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l1_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Технология разработки ПО"
            android:textColor="#1F2937"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l1_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="каб. 314"
            android:textColor="#0D3B66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lesson 2 -->
    <LinearLayout
        android:id="@+id/lesson_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/l2_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="2 · 09:25"
            android:textColor="#0D3B66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l2_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Технология разработки ПО"
            android:textColor="#1F2937"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l2_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="каб. 314"
            android:textColor="#0D3B66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lesson 3 -->
    <LinearLayout
        android:id="@+id/lesson_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/l3_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="3 · 10:20"
            android:textColor="#0D3B66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l3_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Иностранный язык (проф.)"
            android:textColor="#1F2937"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l3_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="215 / 308"
            android:textColor="#0D3B66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lesson 4 -->
    <LinearLayout
        android:id="@+id/lesson_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/l4_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="4 · 11:25"
            android:textColor="#0D3B66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l4_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Базы данных и СУБД"
            android:textColor="#1F2937"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l4_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="каб. 402"
            android:textColor="#0D3B66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty state text (hidden by default) -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Нет уроков на этот день 🎉"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
